{
  "name": "hr-agroriego-iot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "demo": "node scripts/demo.mjs",
    "start:api": "node server/index.js",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:api": "node --test tests/api.test.mjs",
    "test:demo": "node --test tests/demo.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "test": "node --test tests/api.test.mjs tests/validation.test.mjs tests/persistence.test.mjs tests/weather.test.mjs tests/weather-api.test.mjs",
    "start": "node server/demo.js",
    "test:browser": "node scripts/test-browser.mjs",
    "start:weather": "node --env-file=.env.weather server/demo.js",
    "weather:update": "node --env-file=.env.weather scripts/weather-local.mjs update",
    "weather:show": "node --env-file=.env.weather scripts/weather-local.mjs show"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tabler/icons-react": "^3.47.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^3.10.1",
    "vite": "6.4.2"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
