# La URL real se mantiene fuera del código y de la interfaz pública.
WEATHER_SOURCE_URL=

# En desarrollo, Vite redirige /api al backend local del recorrido vertical.
VITE_API_BASE_URL=/api

# Opcionales; establecer en el entorno del proceso para el servidor Node.
# DB_PATH=data/agroriego.sqlite
# API_PORT=3001
# DEMO_PORT=4173

# Copiar estas opciones a .env.weather (privado). Completar coordenadas localmente.
# WEATHER_PROVIDER=open-meteo
# WEATHER_LATITUDE=
# WEATHER_LONGITUDE=
# WEATHER_TIMEZONE=America/Argentina/Buenos_Aires
# WEATHER_FORECAST_DAYS=3
